{
  "lastChangelogVersion": "1.1.0",
  "theme": "system",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:pi-subagents"
  ],
  "defaultTools": [
    "+codemode",
    "+grep",
    "+find",
    "+ls"
  ],
  "codemode": {
    "mode": "only"
  },
  "subagents": {
    "defaultModel": "openai-codex/gpt-6.1-sol",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "scoped"
      ],
      "agents": {
        "delegate": {
          "allow": [
            "openai-codex/*"
          ]
        },
        "evidence-auditor": {
          "allow": [
            "openai-codex/*"
          ]
        },
        "oracle": {
          "allow": [
            "openai-codex/*"
          ]
        },
        "researcher": {
          "allow": [
            "openai-codex/*"
          ]
        },
        "reviewer": {
          "allow": [
            "openai-codex/*"
          ]
        },
        "scout": {
          "allow": [
            "openai-codex/*"
          ]
        },
        "worker": {
          "allow": [
            "openai-codex/*"
          ]
        }
      }
    },
    "watchdog": {
      "enabled": false,
      "main": {
        "model": "openai-codex/gpt-6.1-sol"
      },
      "children": {
        "enabled": false,
        "model": "openai-codex/gpt-6.1-sol"
      }
    },
    "agentOverrides": {
      "delegate": {
        "tools": [
          "codemode",
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor"
        ]
      },
      "worker": {
        "tools": [
          "codemode",
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor"
        ]
      },
      "scout": {
        "tools": [
          "codemode",
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "contact_supervisor"
        ]
      },
      "reviewer": {
        "tools": [
          "codemode",
          "read",
          "grep",
          "find",
          "ls",
          "watchdog_diff",
          "contact_supervisor"
        ]
      },
      "oracle": {
        "tools": [
          "codemode",
          "read",
          "grep",
          "find",
          "ls",
          "bash"
        ]
      },
      "researcher": {
        "tools": [
          "codemode",
          "read",
          "write",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check"
        ],
        "subagentOnlyExtensions": [
          "~/.pi/agent/npm/node_modules/pi-web-access"
        ]
      },
      "evidence-auditor": {
        "tools": [
          "codemode",
          "read",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check"
        ],
        "subagentOnlyExtensions": [
          "~/.pi/agent/npm/node_modules/pi-web-access"
        ]
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    }
  },
  "editorPaddingX": 1,
  "outputPad": 1,
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "quietStartup": true,
  "hideThinkingBlock": true,
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "externalEditor": "nvim",
  "compaction": {
    "reserveTokens": 27201
  },
  "defaultProjectTrust": "ask",
  "modelThinkingLevels": {
    "openai-codex/gpt-6.1-sol": "high"
  },
  "tuiMode": "fullscreen",
  "deviceId": "0ed4cd7c-301b-4873-882b-fd30b83105b5"
}