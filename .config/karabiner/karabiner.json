{
    "global": { "check_for_updates_on_startup": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Change caps_lock key to left_control if pressed with other keys. (Post escape when pressed alone)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [
                                    {
                                        "hold_down_milliseconds": 100,
                                        "key_code": "escape"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "left cmd as tmux prefix (CTRL + A) when alone in Ghostty",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "left_command"
                                },
                                "to": {
                                    "key_code": "left_command"
                                },
                                "to_if_alone": [
                                    {
                                        "key_code": "a",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "TAB to shift+option+control (hyper) or TAB (If Alone)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "tab",
                                    "modifiers": {}
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_option", "left_control"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "tab" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "TAB + [ / ] to navigate spaces (hyper)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "open_bracket",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_shift"] }
                                },
                                "to": [{ "key_code": "left_arrow", "modifiers": ["left_control"] }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "close_bracket",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_shift"] }
                                },
                                "to": [{ "key_code": "right_arrow", "modifiers": ["left_control"] }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
